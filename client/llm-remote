#!/usr/bin/env bash
# llm-remote - use the GPU machine's local models from another machine.
# Everything runs over there through `ssh <host> llm ...`; this script only does the plumbing.
#
#   llm-remote ask "question"                       instant answer   (cat file | llm-remote ask "review this")
#   llm-remote submit [opts] "what you want done"   queue a job, prints its id
#        --project NAME   --model NAME   --ctx 32768   --web
#        --return answer|report|patch|pr     --file PATH (repeatable: evidence for the job)
#        --edit   --max-turns 80   --group NAME   --step 1/3      (coding jobs)
#   llm-remote brief FILE     queue a job written as a brief file (front matter + text)
#   llm-remote lint FILE      check a coding brief for the usual gaps, without queueing it
#   llm-remote run [opts] "..."   submit + follow the log + print the result
#   llm-remote status ID      one line: queued (position) / running (time, turn) / done
#   llm-remote wait ID        block until done, print the result
#   llm-remote log ID [-f]    transcript of what the model did; -f follows it live
#   llm-remote get ID [NAME]  list a job's artifacts, or print one (get ID changes.patch > x.patch)
#   llm-remote cancel ID      remove a queued job, or stop a running one
#   llm-remote ps | models    GPU, dispatcher, queue, recent jobs | installed models
#
# Environment: LLM_REMOTE_HOST  ssh host alias of the GPU machine (default: llmhost)
#              LLM_REMOTE_FROM  this machine's name in job ids (default: its hostname)
#              LLM_REMOTE_SSH   full replacement for the ssh command, e.g. "ssh -p 2222 me@box"
set -euo pipefail
HOST="${LLM_REMOTE_HOST:-llmhost}"
WHO="${LLM_REMOTE_FROM:-$(hostname -s 2>/dev/null || hostname)}"
WHO="$(printf '%s' "$WHO" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-' | cut -c1-20)"; WHO="${WHO:-client}"
if [ -n "${LLM_REMOTE_SSH:-}" ]; then read -r -a SSH <<<"$LLM_REMOTE_SSH"; else SSH=(ssh -o BatchMode=yes "$HOST"); fi
r() { "${SSH[@]}" "$@" | tr -d '\r'; }
raw() { "${SSH[@]}" "$@"; }
safe() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-60; }
need() { [ -n "${1:-}" ] || { echo "llm-remote: this command needs a job id" >&2; exit 2; }; }
parent() { [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || printf ' --parent %s' "$(safe "$CLAUDE_CODE_SESSION_ID")"; }

submit() {
  local project="" model="" ctx="" web="" ret="" edit="" turns="" group="" step="" files=() ask=""
  while [ $# -gt 0 ]; do case "$1" in
    --project) project="$2"; shift 2;; --model) model="$2"; shift 2;; --ctx) ctx="$2"; shift 2;;
    --return) ret="$2"; shift 2;; --file) files+=("$2"); shift 2;; --web) web=true; shift;;
    --edit) edit=true; shift;; --max-turns) turns="$2"; shift 2;;
    --group) group="$2"; shift 2;; --step) step="$2"; shift 2;;
    *) ask="${ask:+$ask }$1"; shift;; esac; done
  [ -n "$ask" ] || { echo "llm-remote: nothing to submit" >&2; exit 2; }
  local id; id="$(r "llm newid --from $WHO")"
  for f in ${files[@]+"${files[@]}"}; do r "llm put $id $(safe "$(basename "$f")")" <"$f" >&2; done
  { echo "---"; echo "from: $WHO"
    [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || echo "parent_session: $CLAUDE_CODE_SESSION_ID"
    [ -z "$project" ] || echo "project: $project"; [ -z "$model" ] || echo "model: $model"
    [ -z "$ctx" ] || echo "ctx: $ctx"; [ -z "$web" ] || echo "web: true"; [ -z "$ret" ] || echo "return: $ret"
    [ -z "$edit" ] || echo "edit: true"; [ -z "$turns" ] || echo "max_turns: $turns"
    [ -z "$group" ] || echo "group: $group"; [ -z "$step" ] || echo "step: $step"
    echo "---"; echo; printf '%s\n' "$ask"; } | r "llm submit - --id $id"
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  ask)    if [ -t 0 ]; then printf '%s' "$*" | r "llm ask -"; else { printf '%s\n\n' "$*"; cat; } | r "llm ask -"; fi ;;
  submit) submit "$@" ;;
  brief)  [ -f "${1:-}" ] || { echo "llm-remote: brief needs a file" >&2; exit 2; }
          r "llm submit - --from $WHO$(parent)" <"$1" ;;
  lint)   [ -f "${1:-}" ] || { echo "llm-remote: lint needs a file" >&2; exit 2; }
          r "llm lint -" <"$1" ;;
  run)    id="$(submit "$@")"; echo "job $id" >&2; r "llm log $id -f" >&2; r "llm wait $id" ;;
  status) need "${1:-}"; r "llm status $(safe "$1")" ;;
  wait)   need "${1:-}"; r "llm wait $(safe "$1")" ;;
  log)    need "${1:-}"; id="$(safe "$1")"; shift; r "llm log $id ${1:+-f}" ;;
  get)    need "${1:-}"; if [ -n "${2:-}" ]; then raw "llm get $(safe "$1") $(safe "$2")"; else r "llm get $(safe "$1")"; fi ;;
  cancel) need "${1:-}"; r "llm cancel $(safe "$1")" ;;
  ps|models) r "llm $cmd" ;;
  *)      sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
